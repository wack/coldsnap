# Coldsnap environment. Copy to .env.local for local development; set the
# same variables on the Vercel project for deployments (`vercel env add`).

# ── Admin sign-in (Sign in with Vercel) ─────────────────────────────────────
# Create an app under Vercel → Team Settings → Apps, add the callback URL
# https://<coldsnap-domain>/api/auth/callback (and http://localhost:3000/api/auth/callback).
NEXT_PUBLIC_VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=
# Who may sign in: Vercel user ids, usernames, or emails, comma separated.
COLDSNAP_ADMIN_ALLOWLIST=
# Signs the dashboard session cookie. 32+ random characters: `openssl rand -hex 32`.
COLDSNAP_SESSION_SECRET=

# ── Tenants (Vercel for Platforms, multi-project) ───────────────────────────
# Access token allowed to create projects, deployments, env vars, and domains.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
# Optional. With a root domain, sites live at <subdomain>.<root domain>; the
# domain must be on the team with wildcard DNS pointed at Vercel. Without it,
# each site uses its project's <prefix><subdomain>.vercel.app address.
COLDSNAP_ROOT_DOMAIN=
COLDSNAP_PROJECT_PREFIX=coldsnap-

# ── Storage ─────────────────────────────────────────────────────────────────
# Neon Postgres (Vercel Marketplace). Unset → local PGlite in .data/pglite.
DATABASE_URL=
# Vercel Blob store connected to the project.
BLOB_READ_WRITE_TOKEN=

# ── Agent ───────────────────────────────────────────────────────────────────
# On Vercel the project's OIDC token pays for AI Gateway and Vercel Sandbox.
# Locally, set an AI Gateway key (or run `vercel env pull` for an OIDC token).
AI_GATEWAY_API_KEY=
COLDSNAP_DEFAULT_MODEL=openai/gpt-5.5
# Optional overrides for where workflows reach the eve agent and how.
# COLDSNAP_AGENT_URL=
# COLDSNAP_AGENT_TOKEN=
# VERCEL_AUTOMATION_BYPASS_SECRET=

# ── Local development ───────────────────────────────────────────────────────
# memory: in-memory Vercel, Blob, agent, and screenshots, so the whole flow
# runs offline. Leave unset in deployments.
# COLDSNAP_DRIVERS=memory
# One-click "dev Frank" login on `next dev` only.
# COLDSNAP_DEV_LOGIN=1
# Local Chromium for preview screenshots when not on Vercel.
# CHROMIUM_EXECUTABLE_PATH=
