{
  "name": "coldsnap",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:agent": "eve dev",
    "build:agent": "eve build",
    "embed": "node scripts/embed-assets.mjs",
    "embed:check": "node scripts/embed-assets.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:workflows": "vitest run --config vitest.workflows.config.ts",
    "eval": "eve eval",
    "postinstall": "node scripts/patch-eve-cjs-require.mjs"
  },
  "dependencies": {
    "@ai-sdk/harness": "^1.0.138",
