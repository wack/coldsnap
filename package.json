    "@neondatabase/serverless": "^1.2.0",
    "@sparticuz/chromium": "^153.0.0",
    "@vercel/blob": "^2.8.0",
    "@vercel/oidc": "^4.0.0",
    "@vercel/sdk": "^1.28.38",
    "ai": "^7.0.105",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "eve": "^0.67.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.51.0",
    "next": "^16.3.8",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
