    "@testing-library/user-event": "^14.6.7",
    "@types/node": "24.x",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@workflow/vitest": "^5.0.1",
    "jsdom": "^30.1.1",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vercel": "^60.1.3",
